MONGODB_URI=
PORT=4000

# Clave para borrar archivos multimedia (cabecera x-admin-key). Sin ella, el borrado queda deshabilitado.
ADMIN_KEY=

# Email que puede borrar cualquier foto o vídeo desde la web (por defecto helenuky_libra@hotmail.com).
ADMIN_EMAIL=

# Configuración SMTP de IONOS para el envío de emails
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reservas@helenfest.com
SMTP_PASS=
MAIL_FROM=reservas@helenfest.com
